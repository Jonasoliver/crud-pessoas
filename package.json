{
  "name": "crud-pessoas",
  "version": "1.0.0",
  "description": "CRUD de pessoas (CPF, nome, data de nascimento) com cálculo de idade, desenvolvido com TDD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
